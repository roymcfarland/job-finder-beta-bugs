PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_NAME=Atlas Beta Bug Reporter
APP_BASE_URL=http://127.0.0.1:3000

# Use DATABASE_URL locally. In production, any of DATABASE_URL, POSTGRES_URL,
# POSTGRES_PRISMA_URL or POSTGRES_URL_NON_POOLING (e.g. injected by a hosted Postgres
# integration such as Supabase) is picked up automatically.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/beta_bug_reporter

# Postgres TLS verification. Off by default to stay compatible with hosted
# pooler certs. Set to true once a valid CA bundle is configured below.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_CA=

# Comma-separated admin emails. Any matching account is promoted to admin automatically.
ADMIN_EMAILS=admin@example.com

# Shared registration invite code, required in production for non-admin accounts.
# If unset or blank, production registration fails closed; other environments stay open.
# Emails listed in ADMIN_EMAILS bypass the invite gate, even when registration is closed.
# Generate with: openssl rand -hex 16
REGISTRATION_INVITE_CODE=

# Shared secret required for /api/cron/* endpoints. Vercel Cron auto-injects
# this as `Authorization: Bearer ${CRON_SECRET}` when the env var is set.
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# Required for password reset emails in production.
RESEND_API_KEY=
EMAIL_FROM=bugs@example.com

# Optional bug-report notification target. Reports are still stored in Postgres even if unset.
BUG_REPORT_NOTIFICATION_TO_EMAIL=triage@example.com

# Optional alternative bug notification destination.
# REPORT_WEBHOOK_URL=https://example.com/bug-intake
# REPORT_WEBHOOK_TOKEN=

# Optional if your frontend is hosted on a different origin.
# ALLOWED_ORIGIN=https://bugs.example.com

# Honor X-Forwarded-For / X-Real-IP for client IP and rate limiting. Only enable
# this when running behind a trusted proxy that sets these headers (Vercel,
# Cloudflare, an Nginx LB, etc.). Auto-detected as true on Vercel.
# TRUST_PROXY=false

PASSWORD_MIN_LENGTH=10
# Defaults to `__Host-bug_reporter_session` when serving over HTTPS in production.
# SESSION_COOKIE_NAME=bug_reporter_session
# Set to false to drop the Secure flag on the session cookie in production (not recommended).
# SESSION_COOKIE_SECURE=true
SESSION_TTL_MS=2592000000
PASSWORD_RESET_TTL_MS=3600000

AUTH_RATE_LIMIT_MAX=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
# Rate limit for admin API requests (defaults shown).
# ADMIN_RATE_LIMIT_MAX=240
# ADMIN_RATE_LIMIT_WINDOW_MS=900000
